{
  "name": "dome-launcher",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "bunx --package @tauri-apps/cli tauri dev",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "bunx --package @tauri-apps/cli tauri",
    "vite": "vite",
    "tauri:build": "bunx --package @tauri-apps/cli tauri build",
    "verificar": "bun run build && cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --all-targets"
  },
  "dependencies": {
    "@iconify-icons/pixelarticons": "^1.2.5",
    "@iconify/react": "^6.0.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@types/three": "^0.182.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-skinview3d": "^7.0.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "skinview3d": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@babel/core": ">7.29.0",
    "nanoid": ">=3.3.16",
    "picomatch": ">=4.0.4",
    "postcss": ">8.5.22",
    "rollup": ">=4.59.0",
    "socket.io-parser": ">=4.2.7",
    "ws": ">=8.20.1"
  }
}
